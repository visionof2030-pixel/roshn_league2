let pickFid = null;
function openPick(fid){
  if (!S.me){ toast('سجّل اسمك أولاً'); $('#meBtn').click(); return; }
  const f = fixtureById(fid); if (!f) return;
  if (f.round > S.currentRound){
    toast(`التوقع مفتوح على الجولة ${S.currentRound} فقط — الجولة ${f.round} تُفتح بعد انتهائها`);
    return;
  }
  if (isLocked(f.kickoff)){ toast('أُقفل التوقع — بقي أقل من 5 دقائق على الصافرة'); return; }

  pickFid = fid;
  $('#pickTitle').textContent = `${tName(f.home)} × ${tName(f.away)}`;
  $('#pickWhen').textContent = `${ksaDate(f.kickoff)} · ${ksaTime(f.kickoff)} بتوقيت السعودية`;

  const mine = myPred(fid);
  const opts = [['HOME','فوز '+tName(f.home)],['DRAW','تعادل'],['AWAY','فوز '+tName(f.away)]];
  $('#pickOpts').innerHTML = opts.map(([v,l])=>`
    <label class="opt ${mine && mine.prediction===v ? 'sel':''}">
      <input type="radio" name="pk" value="${v}" ${mine&&mine.prediction===v?'checked':''}> <span>${l}</span>
    </label>`).join('');
  $$('#pickOpts .opt').forEach(o=>o.onclick=()=>{
    $$('#pickOpts .opt').forEach(x=>x.classList.remove('sel')); o.classList.add('sel');
  });
  $('#pickNote').textContent=''; $('#pickNote').className='note';
  $('#pickSave').textContent = mine ? 'تحديث التوقع' : 'حفظ التوقع';
  show('#vPick');
}

$('#pickSave').onclick = async function(){
  const sel = $('#pickOpts input:checked');
  const note = $('#pickNote');
  if (!sel){ note.className='note err'; note.textContent='اختر نتيجة'; return; }

  const f = fixtureById(pickFid);
  if (f.round > S.currentRound){ note.className='note err'; note.textContent=`التوقع مفتوح على الجولة ${S.currentRound} فقط`; return; }
  if (isLocked(f.kickoff)){ note.className='note err'; note.textContent='أُقفل التوقع لهذه المباراة'; return; }
  if (!sb || !sbConnected){ 
    note.className='note err'; 
    note.textContent='⚠️ لا يوجد اتصال بقاعدة البيانات. تأكد من اتصال الإنترنت.';
    return; 
  }

  this.disabled = true; note.className='note info'; note.textContent='جارٍ الحفظ…';
  const mid = 'spl_' + pickFid;
  const mine = myPred(pickFid);

  try{
    if (mine){
      const { error } = await sb.from('predictions')
        .update({ prediction: sel.value, updated_at: new Date().toISOString() })
        .eq('id', mine.id);
      if (error) throw error;
    } else {
      const { error } = await sb.from('predictions')
        .insert([{ 
          user_name:S.me, 
          match_id:mid, 
          prediction:sel.value, 
          competition:CFG.COMP,
          created_at: new Date().toISOString(),
          updated_at: new Date().toISOString()
        }]);
      if (error) throw error;
    }
    await fetchPreds();
    renderMatches(); renderBoard();
    note.className='note ok'; note.textContent='✅ تم الحفظ بنجاح';
    setTimeout(()=>hide('#vPick'), 800);
    toast('تم حفظ توقعك');
  }catch(e){
    console.error('❌ خطأ في حفظ التوقع:', e);
    let msg = 'لم يُحفظ التوقع: ';
    if (e.message && e.message.includes('permission')) {
      msg += 'تحتاج إلى تفعيل RLS في Supabase. تأكد من تنفيذ سياسات الأمان.';
    } else {
      msg += e.message || 'خطأ غير معروف';
    }
    note.className='note err';
    note.textContent = msg;
    toast('❌ فشل حفظ التوقع');
  }finally{ 
    this.disabled = false; 
  }
};

/* --- توقعات مباراة --- */
function openMatch(fid){
  const f = fixtureById(fid); if (!f) return;
  const all = predsOf(fid).sort((a,b)=> new Date(a.created_at) - new Date(b.created_at));
  const res = outcome(f);

  $('#mpTitle').textContent = `${tName(f.home)} × ${tName(f.away)}`;
  $('#mpLead').textContent = f.finished
    ? `النتيجة ${f.hs} - ${f.as} · ${all.length} توقع`
    : `${ksaDate(f.kickoff)} · ${all.length} توقع`;

  $('#mpList').innerHTML = all.length ? all.map(p=>{
    let tag = '<span class="tag wait">بانتظار النتيجة</span>';
    if (res) tag = p.prediction === res
      ? '<span class="tag ok">صحيح</span>' : '<span class="tag no">خاطئ</span>';
    return `<div class="pitem">
      <span class="who" onclick="hide('#vMatch');openPlayer('${p.user_name.replace(/'/g,"\\'")}')"
            style="cursor:pointer;color:var(--green)">${p.user_name}</span>
      <span style="color:var(--ink-2)">${predLabel(f, p.prediction)}</span>${tag}
    </div>`;
  }).join('') : `<div class="empty"><span>📭</span> لا توقعات لهذه المباراة بعد</div>`;

  show('#vMatch');
}

/* --- توقعات لاعب --- */
function openPlayer(name){
  const mine = S.preds.filter(p=>p.user_name===name);
  const u = scoreboard().find(x=>x.name===name);
  const rank = scoreboard().findIndex(x=>x.name===name) + 1;
  const acc = u && (u.ok+u.no) ? Math.round(u.ok/(u.ok+u.no)*100) : 0;

  $('#plTitle').textContent = name;
  $('#plLead').textContent = u
    ? `المركز ${rank} · ${u.pts} نقطة · دقة ${acc}% · ${u.total} توقع`
    : 'لا توقعات';

  $('#plList').innerHTML = mine.length ? mine.map(p=>{
    const f = fixtureById(+String(p.match_id).replace('spl_',''));
    if (!f) return '';
    const res = outcome(f);
    let tag = '<span class="tag wait">لم تُلعب</span>';
    if (res) tag = p.prediction === res
      ? '<span class="tag ok">صحيح</span>' : '<span class="tag no">خاطئ</span>';
    return `<div class="pitem">
      <span class="who">ج${f.round} · ${tName(f.home)} × ${tName(f.away)}</span>
      <span style="color:var(--ink-2)">${predLabel(f, p.prediction)}</span>${tag}
    </div>`;
  }).join('') : `<div class="empty"><span>📭</span> لا توقعات</div>`;

  show('#vPlayer');
}

/* --- الإدارة --- */
$('#foot').onclick = ()=>{
  if (S.admin){ toast(`${S.preds.length} توقع · ${S.fixtures.length} مباراة · الجولة ${S.currentRound}`); return; }
  $('#pwIn').value=''; $('#pwNote').textContent=''; show('#vAdmin');
};
$('#pwGo').onclick = ()=>{
  if ($('#pwIn').value.trim() === CFG.ADMIN_CODE){
    S.admin = true; hide('#vAdmin'); toast('تم فتح لوحة الإدارة');
  } else {
    $('#pwNote').className='note err'; $('#pwNote').textContent='رمز غير صحيح';
    $('#pwIn').value=''; $('#pwIn').focus();
  }
};
$('#pwIn').addEventListener('keydown',e=>{ if(e.key==='Enter') $('#pwGo').click(); });

/* --- التبويبات --- */
$$('.tab').forEach(t=>t.onclick=()=>{
  $$('.tab').forEach(x=>x.classList.remove('on')); t.classList.add('on');
  $$('.panel').forEach(p=>p.classList.remove('on'));
  $('#p-'+t.dataset.p).classList.add('on');
});

/* =====================================================================
   8) التشغيل
   ===================================================================== */
S.me = localStorage.getItem('splName') || '';
if (S.me) $('#meBtn').querySelector('span').textContent = S.me;

loadAll();
setInterval(()=>{ if (S.ready) renderMatches(); }, 30000);   // تحديث العدّاد
setInterval(()=>{ if (S.ready) loadAll(); }, 300000);        // إعادة جلب كل 5 دقائق

window.openPick = openPick;
window.openMatch = openMatch;
window.openPlayer = openPlayer;
window.loadAll = loadAll;
window.hide = hide;
</script>
</body>

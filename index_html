<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<title>توقعات دوري روشن السعودي 2026/27</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<!--
=====================================================================
  إعداد قاعدة البيانات — نفّذ هذا مرة واحدة في Supabase SQL Editor
=====================================================================

  -- إنشاء الجدول إذا لم يكن موجوداً
  CREATE TABLE IF NOT EXISTS predictions (
    id bigint PRIMARY KEY GENERATED ALWAYS AS IDENTITY,
    user_name text NOT NULL,
    match_id text NOT NULL,
    prediction text NOT NULL CHECK (prediction IN ('HOME', 'DRAW', 'AWAY')),
    competition text NOT NULL DEFAULT 'spl',
    created_at timestamptz NOT NULL DEFAULT now(),
    updated_at timestamptz NOT NULL DEFAULT now()
  );

  -- إضافة فهارس للبحث السريع
  CREATE INDEX IF NOT EXISTS idx_predictions_user_name ON predictions (user_name);
  CREATE INDEX IF NOT EXISTS idx_predictions_match_id ON predictions (match_id);
  CREATE INDEX IF NOT EXISTS idx_predictions_competition ON predictions (competition);

  -- تفعيل Row Level Security
  ALTER TABLE predictions ENABLE ROW LEVEL SECURITY;

  -- سياسات الأمان (تعديل حسب الحاجة)
  CREATE POLICY "Allow all operations for everyone" ON predictions
    FOR ALL USING (true) WITH CHECK (true);

  ⚠️ ملاحظة: السياسة أعلاه تسمح للجميع بكل العمليات. 
     في الإنتاج، يُفضل تقييدها أكثر.
=====================================================================
-->

<style>
:root{
  /* ===== هوية دوري روشن — أخضر ===== */
  --bg:#04150d;
  --bg-2:#07200f;
  --surface:rgba(11,42,25,.72);
  --surface-2:rgba(15,56,33,.85);
  --line:rgba(255,255,255,.07);
  --line-green:rgba(0,209,102,.28);

  --green:#00d166;
  --green-deep:#00a34f;
  --green-soft:rgba(0,209,102,.12);
  --green-grad:linear-gradient(135deg,#00e575,#009d4c);

  --ink:#eefaf2;
  --ink-2:#8fb8a2;
  --ink-3:#5c8570;

  --win:#00d166;
  --lose:#ff5c6c;
  --draw:#ffc94d;

  --r-lg:22px; --r-md:14px; --r-sm:9px;
  --t:all .25s cubic-bezier(.4,0,.2,1);
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
body{
  font-family:'Cairo',system-ui,sans-serif;
  background:
    radial-gradient(1100px 520px at 50% -10%,rgba(0,209,102,.10),transparent 60%),
    var(--bg);
  color:var(--ink);font-size:14px;line-height:1.75;min-height:100vh;
}
::-webkit-scrollbar{width:5px;height:5px}
::-webkit-scrollbar-thumb{background:var(--green-deep);border-radius:9px}
::-webkit-scrollbar-track{background:transparent}

.wrap{max-width:1180px;margin:0 auto;padding:0 14px 60px}

/* ===== الترويسة ===== */
.masthead{
  position:relative;overflow:hidden;
  background:linear-gradient(160deg,#06301a,#04150d 70%);
  border-bottom:2px solid var(--green);
  padding:26px 20px 22px;margin-bottom:20px;
}
.masthead::after{
  content:"";position:absolute;inset:auto -10% -70% auto;width:420px;height:420px;
  background:radial-gradient(circle,rgba(0,209,102,.16),transparent 68%);
  border-radius:50%;pointer-events:none;
}
.mast-in{max-width:1180px;margin:0 auto;position:relative;z-index:2;
  display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap}
.mast-title{font-size:1.45rem;font-weight:900;letter-spacing:-.4px;line-height:1.3}
.mast-title b{background:var(--green-grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.mast-sub{font-size:.72rem;color:var(--ink-2);font-weight:600;margin-top:2px}
.mast-badge{
  background:var(--green-soft);border:1px solid var(--line-green);color:var(--green);
  padding:5px 16px;border-radius:40px;font-size:.7rem;font-weight:800;white-space:nowrap
}

/* ===== شريط علوي ===== */
.toolbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:16px}
.btn{
  background:rgba(255,255,255,.04);border:1px solid var(--line);color:var(--ink-2);
  padding:8px 16px;border-radius:40px;font-size:.7rem;font-weight:700;cursor:pointer;
  font-family:inherit;transition:var(--t);display:inline-flex;align-items:center;gap:6px
}
.btn:hover{border-color:var(--green);color:var(--green);transform:translateY(-1px)}
.btn.solid{background:var(--green-grad);color:#04150d;border:none;font-weight:800}
.btn.solid:hover{color:#04150d;box-shadow:0 6px 24px rgba(0,209,102,.25)}
.btn:disabled{opacity:.4;cursor:not-allowed;transform:none!important}

/* ===== التبويبات ===== */
.tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:18px;
  background:var(--surface);padding:5px;border-radius:40px;border:1px solid var(--line)}
.tab{
  flex:1;min-width:88px;padding:9px 14px;border:none;border-radius:40px;background:transparent;
  color:var(--ink-2);font-size:.72rem;font-weight:800;cursor:pointer;font-family:inherit;transition:var(--t)
}
.tab:hover{color:var(--ink)}
.tab.on{background:var(--green-soft);color:var(--green);box-shadow:inset 0 0 0 1px var(--line-green)}
.panel{display:none;animation:up .35s ease}
.panel.on{display:block}
@keyframes up{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}

.sec-title{font-size:1.05rem;font-weight:900;margin-bottom:14px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.pill{background:var(--green-soft);border:1px solid var(--line-green);color:var(--green);
  font-size:.62rem;font-weight:800;padding:2px 12px;border-radius:40px}

/* ===== منتقي الجولة ===== */
.rounds{display:flex;gap:6px;overflow-x:auto;padding:4px 0 10px;margin-bottom:6px;scrollbar-width:thin}
.round-b{
  flex:0 0 auto;padding:7px 15px;border-radius:40px;border:1px solid var(--line);
  background:rgba(255,255,255,.03);color:var(--ink-2);font-size:.68rem;font-weight:800;
  cursor:pointer;font-family:inherit;transition:var(--t);white-space:nowrap
}
.round-b:hover{border-color:var(--line-green);color:var(--ink)}
.round-b.on{background:var(--green-grad);color:#04150d;border-color:transparent}
.round-b.done{opacity:.55}

/* ===== بطاقة مباراة ===== */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));gap:14px}
.match{
  background:var(--surface);backdrop-filter:blur(14px);
  border:1px solid var(--line);border-radius:var(--r-lg);padding:16px 16px 14px;transition:var(--t)
}
.match:hover{border-color:var(--line-green);transform:translateY(-3px)}
.match.live{border-color:var(--lose);box-shadow:0 0 34px rgba(255,92,108,.10)}
.match.done{opacity:.9}

.m-head{display:flex;justify-content:space-between;align-items:center;font-size:.6rem;color:var(--ink-3);
  font-weight:700;margin-bottom:12px}
.m-live{color:var(--lose);font-weight:900;animation:blink 1.1s infinite}
@keyframes blink{50%{opacity:.35}}

.m-row{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:8px}
.side{display:flex;flex-direction:column;align-items:center;gap:7px;min-width:0}
.crest{
  width:46px;height:46px;border-radius:50%;display:grid;place-items:center;
  font-weight:900;font-size:.82rem;color:#fff;flex-shrink:0;
  box-shadow:0 3px 14px rgba(0,0,0,.35);border:2px solid rgba(255,255,255,.14);
  object-fit:cover;background:#123;overflow:hidden;letter-spacing:-.5px
}
.side-name{font-size:.76rem;font-weight:800;text-align:center;line-height:1.35}
.m-mid{text-align:center;min-width:74px}
.score{font-size:1.35rem;font-weight:900;letter-spacing:1px}
.score.g{color:var(--green)}
.vs{font-size:.66rem;color:var(--ink-3);font-weight:800}
.ko{font-size:.72rem;font-weight:900;color:var(--ink);font-variant-numeric:tabular-nums}
.ko-d{font-size:.56rem;color:var(--ink-3);font-weight:700}

.m-foot{display:flex;gap:7px;margin-top:14px}
.m-foot .btn{flex:1;justify-content:center;font-size:.68rem;padding:9px 10px}
.p-mine{
  margin-top:10px;text-align:center;font-size:.66rem;font-weight:800;padding:6px;border-radius:var(--r-sm);
  background:var(--green-soft);color:var(--green);border:1px solid var(--line-green)
}
.p-mine.ok{background:rgba(0,209,102,.14);color:var(--win)}
.p-mine.no{background:rgba(255,92,108,.12);color:var(--lose);border-color:rgba(255,92,108,.25)}

/* شريط توزيع التوقعات */
.bars{display:flex;height:6px;border-radius:20px;overflow:hidden;background:rgba(255,255,255,.05);margin-top:10px}
.bars i{display:block;height:100%}
.bars-l{display:flex;justify-content:space-between;font-size:.55rem;color:var(--ink-3);margin-top:4px;font-weight:700}

/* ===== الترتيب ===== */
.tbl-wrap{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);overflow:hidden}
table{width:100%;border-collapse:collapse;font-size:.72rem}
th{background:rgba(0,209,102,.09);color:var(--green);padding:11px 6px;font-weight:800;font-size:.64rem;
  border-bottom:1px solid var(--line-green)}
td{padding:9px 6px;text-align:center;border-bottom:1px solid var(--line);font-weight:700}
tr:last-child td{border-bottom:none}
td.team{text-align:right;display:flex;align-items:center;gap:8px;font-weight:800}
td.team .crest{width:26px;height:26px;font-size:.55rem;border-width:1.5px}
.pts{color:var(--green);font-weight:900}
.pos{width:26px;color:var(--ink-3)}
tr.acl td.pos{border-right:3px solid var(--green);color:var(--green)}
tr.rel td.pos{border-right:3px solid var(--lose);color:var(--lose)}
.legend{display:flex;gap:16px;flex-wrap:wrap;font-size:.6rem;color:var(--ink-3);margin-top:10px;padding:0 4px}
.legend i{display:inline-block;width:9px;height:9px;border-radius:2px;margin-left:5px;vertical-align:middle}

/* ===== المتصدرون ===== */
.champ{
  background:linear-gradient(140deg,rgba(0,209,102,.16),rgba(0,209,102,.02));
  border:2px solid var(--green);border-radius:var(--r-lg);padding:18px;margin-bottom:14px;
  display:flex;align-items:center;gap:16px;flex-wrap:wrap;cursor:pointer;transition:var(--t)
}
.champ:hover{transform:translateY(-3px);box-shadow:0 0 50px rgba(0,209,102,.14)}
.av{width:56px;height:56px;border-radius:50%;background:var(--green-grad);display:grid;place-items:center;
  font-size:1.4rem;font-weight:900;color:#04150d;flex-shrink:0}
.champ .who{flex:1;min-width:150px}
.champ .who h3{font-size:1.15rem;font-weight:900;color:var(--green)}
.champ .who .line{display:flex;gap:14px;flex-wrap:wrap;font-size:.68rem;color:var(--ink-2);margin-top:2px}
.champ .who .line b{color:var(--ink)}

.people{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:8px}
.person{
  background:rgba(255,255,255,.02);border:1px solid var(--line);border-radius:var(--r-md);
  padding:10px 13px;display:flex;align-items:center;gap:11px;cursor:pointer;transition:var(--t);position:relative
}
.person:hover{border-color:var(--line-green);background:rgba(255,255,255,.045)}
.person .rk{font-size:.82rem;font-weight:900;color:var(--ink-3);min-width:28px}
.person .av{width:34px;height:34px;font-size:.8rem;background:var(--green-soft);color:var(--green)}
.person .nm{flex:1;min-width:0}
.person .nm .n1{font-size:.76rem;font-weight:800}
.person .nm .n2{font-size:.58rem;color:var(--ink-3);display:flex;gap:9px;font-weight:700}
.person .sc{background:var(--green-grad);color:#04150d;font-weight:900;font-size:.72rem;
  padding:2px 13px;border-radius:40px}
.person.me{border-color:var(--green)}

/* ===== النوافذ ===== */
.veil{position:fixed;inset:0;background:rgba(0,8,4,.82);backdrop-filter:blur(16px);z-index:999;
  display:none;align-items:center;justify-content:center;padding:16px}
.veil.on{display:flex}
.box{background:var(--bg-2);border:1px solid var(--line-green);border-radius:var(--r-lg);
  padding:24px 22px;width:100%;max-width:460px;max-height:88vh;overflow-y:auto;position:relative;
  box-shadow:0 40px 90px rgba(0,0,0,.6)}
.box.wide{max-width:640px}
.x{position:absolute;top:12px;left:14px;width:32px;height:32px;border-radius:50%;border:none;
  background:rgba(255,255,255,.05);color:var(--ink-2);font-size:1.1rem;cursor:pointer;transition:var(--t)}
.x:hover{background:rgba(255,92,108,.16);color:var(--lose)}
.box h2{font-size:1.05rem;font-weight:900;text-align:center;margin-bottom:4px;color:var(--green)}
.box .lead{text-align:center;font-size:.7rem;color:var(--ink-2);margin-bottom:16px}

.opts{display:flex;flex-direction:column;gap:8px;margin:14px 0}
.opt{display:flex;align-items:center;gap:12px;padding:12px 16px;border-radius:40px;cursor:pointer;
  background:rgba(255,255,255,.03);border:2px solid transparent;transition:var(--t);font-weight:800;font-size:.82rem}
.opt:hover{background:rgba(255,255,255,.06)}
.opt.sel{border-color:var(--green);background:var(--green-soft)}
.opt input{appearance:none;width:17px;height:17px;border:2px solid var(--ink-3);border-radius:50%;
  flex-shrink:0;position:relative;cursor:pointer}
.opt input:checked{border-color:var(--green);background:var(--green)}
.opt input:checked::after{content:"✓";position:absolute;inset:0;display:grid;place-items:center;
  color:#04150d;font-size:10px;font-weight:900}

input[type=text],input[type=password]{
  width:100%;padding:13px 18px;border-radius:40px;border:1px solid var(--line);
  background:rgba(255,255,255,.04);color:var(--ink);font-size:.9rem;font-family:inherit;
  outline:none;transition:var(--t);text-align:center
}
input:focus{border-color:var(--green);box-shadow:0 0 0 3px var(--green-soft)}
.note{margin-top:12px;text-align:center;font-size:.72rem;font-weight:700;padding:8px 14px;border-radius:40px;min-height:20px}
.note.ok{color:var(--win);background:rgba(0,209,102,.10)}
.note.err{color:var(--lose);background:rgba(255,92,108,.10)}
.note.info{color:var(--draw);background:rgba(255,201,77,.10)}

.plist{max-height:340px;overflow-y:auto;display:flex;flex-direction:column;gap:6px}
.pitem{background:rgba(255,255,255,.025);border:1px solid var(--line);border-radius:var(--r-sm);
  padding:8px 12px;display:flex;align-items:center;gap:10px;font-size:.7rem}
.pitem .who{flex:1;font-weight:800}
.tag{font-size:.58rem;font-weight:800;padding:1px 10px;border-radius:40px}
.tag.ok{background:rgba(0,209,102,.14);color:var(--win)}
.tag.no{background:rgba(255,92,108,.12);color:var(--lose)}
.tag.wait{background:rgba(255,201,77,.12);color:var(--draw)}

.empty{text-align:center;padding:40px 18px;color:var(--ink-3);border:1px dashed var(--line);
  border-radius:var(--r-lg);grid-column:1/-1}
.empty span{display:block;font-size:2rem;margin-bottom:8px}

.toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%);background:var(--green-grad);
  color:#04150d;padding:11px 26px;border-radius:40px;font-weight:800;font-size:.78rem;z-index:9999;
  display:none;box-shadow:0 14px 44px rgba(0,0,0,.4)}
.toast.on{display:block}

.foot{margin-top:44px;text-align:center;font-size:.6rem;color:var(--ink-3);
  border-top:1px solid var(--line);padding-top:20px;cursor:pointer;user-select:none}
.foot:hover{color:var(--green)}

@media (max-width:600px){
  .masthead{padding:18px 14px}
  .mast-title{font-size:1.1rem}
  .grid{grid-template-columns:1fr}
  .people{grid-template-columns:1fr}
  table{font-size:.62rem}
  th,td{padding:7px 3px}
  td.team .crest{width:22px;height:22px}
  .champ{flex-direction:column;text-align:center}
}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>

<header class="masthead">
  <div class="mast-in">
    <div>
      <div class="mast-title">توقعات <b>دوري روشن السعودي</b></div>
      <div class="mast-sub">موسم 2026/27 · 18 نادياً · 34 جولة</div>
    </div>
    <div class="mast-badge" id="roundBadge">جارٍ التحميل…</div>
  </div>
</header>

<div class="wrap">

  <div class="toolbar">
    <button class="btn solid" id="meBtn">👤 <span>سجّل اسمك</span></button>
    <button class="btn" onclick="loadAll(true)">🔄 تحديث</button>
    <span style="flex:1"></span>
    <span class="pill" id="liveStat">—</span>
  </div>

  <div class="tabs">
    <button class="tab on" data-p="matches">⚽ المباريات</button>
    <button class="tab" data-p="table">📊 الترتيب</button>
    <button class="tab" data-p="board">🏆 المتصدرون</button>
  </div>

  <!-- المباريات -->
  <section class="panel on" id="p-matches">
    <div class="rounds" id="rounds"></div>
    <div class="grid" id="matches">
      <div class="empty"><span>⏳</span> جارٍ تحميل المباريات…</div>
    </div>
  </section>

  <!-- الترتيب -->
  <section class="panel" id="p-table">
    <div class="sec-title">📊 ترتيب دوري روشن <span class="pill" id="tblNote">—</span></div>
    <div class="tbl-wrap"><table id="tbl"></table></div>
    <div class="legend">
      <span><i style="background:var(--green)"></i> دوري أبطال آسيا</span>
      <span><i style="background:var(--lose)"></i> الهبوط</span>
      <span>يُحتسب من المباريات المنتهية فقط</span>
    </div>
  </section>

  <!-- المتصدرون -->
  <section class="panel" id="p-board">
    <div class="sec-title">🏆 ترتيب المتوقعين <span class="pill" id="boardNote">—</span></div>
    <div id="board"><div class="empty"><span>⏳</span> جارٍ الحساب…</div></div>
  </section>

  <div class="foot" id="foot">دوري روشن السعودي 2026/27 · توقّع · نافس</div>
</div>

<!-- نافذة الاسم -->
<div class="veil" id="vName"><div class="box">
  <button class="x" data-close>✕</button>
  <h2>اكتب اسمك</h2>
  <p class="lead">يُستخدم لتسجيل توقعاتك ومتابعة ترتيبك</p>
  <input type="text" id="nameIn" maxlength="30" placeholder="الاسم" />
  <div class="note" id="nameNote"></div>
  <button class="btn solid" style="width:100%;justify-content:center;margin-top:12px;padding:13px" id="nameGo">متابعة</button>
</div></div>

<!-- نافذة التوقع -->
<div class="veil" id="vPick"><div class="box">
  <button class="x" data-close>✕</button>
  <h2 id="pickTitle">توقّع النتيجة</h2>
  <p class="lead" id="pickWhen"></p>
  <div class="opts" id="pickOpts"></div>
  <button class="btn solid" style="width:100%;justify-content:center;padding:13px" id="pickSave">حفظ التوقع</button>
  <div class="note" id="pickNote"></div>
</div></div>

<!-- نافذة توقعات مباراة -->
<div class="veil" id="vMatch"><div class="box wide">
  <button class="x" data-close>✕</button>
  <h2 id="mpTitle">توقعات المباراة</h2>
  <p class="lead" id="mpLead"></p>
  <div class="plist" id="mpList"></div>
</div></div>

<!-- نافذة لاعب -->
<div class="veil" id="vPlayer"><div class="box wide">
  <button class="x" data-close>✕</button>
  <h2 id="plTitle">توقعات اللاعب</h2>
  <p class="lead" id="plLead"></p>
  <div class="plist" id="plList"></div>
</div></div>

<!-- نافذة الإدارة -->
<div class="veil" id="vAdmin"><div class="box">
  <button class="x" data-close>✕</button>
  <h2>لوحة الإدارة</h2>
  <p class="lead">أدخل رمز الدخول</p>
  <input type="password" id="pwIn" maxlength="12" placeholder="••••" />
  <div class="note" id="pwNote"></div>
  <button class="btn solid" style="width:100%;justify-content:center;margin-top:12px;padding:13px" id="pwGo">دخول</button>
</div></div>

<div class="toast" id="toast"></div>

<script>
/* =====================================================================
   1) الإعدادات
   ===================================================================== */
const CFG = {
  API:  'https://en.fantasy.spl.com.sa/api',
  SB_URL: 'https://szjxwhsmefqpfcebtvei.supabase.co',
  SB_KEY: 'sb_publishable_0um28lgPMHcjDOThT0UgDA_K-Y7Wmx3',

/* الوقت بتوقيت السعودية */
function ksaTime(iso){
  return new Date(iso).toLocaleTimeString('ar-SA',
    {hour:'2-digit',minute:'2-digit',hour12:false,timeZone:CFG.TZ});
}
function ksaDate(iso){
  return new Date(iso).toLocaleDateString('ar-SA',
    {weekday:'long',day:'numeric',month:'long',timeZone:CFG.TZ});
}
function isLocked(iso){
  return Date.now() > (new Date(iso).getTime() - CFG.LOCK_MIN*60000);
}
function countdown(iso){
  let d = new Date(iso).getTime() - Date.now();
  if (d <= 0) return 'بدأت';
  const day = Math.floor(d/864e5); d -= day*864e5;
  const h = Math.floor(d/36e5);    d -= h*36e5;
  const m = Math.floor(d/6e4);
  if (day > 0) return `بعد ${day} يوم`;
  if (h > 0)   return `بعد ${h}س ${m}د`;
  return `بعد ${m} دقيقة`;
}

/* =====================================================================
   3) جلب البيانات — مع تجاوز حجب CORS
   -----------------------------------------------------------------
   خادم الرابطة قد يمنع الاتصال المباشر من المتصفح، خصوصاً عند فتح
   الملف من الجهاز (file://). نجرّب الاتصال المباشر أولاً، فإن فشل
   نمرّ عبر وسيط عام. استضافة الملف على الإنترنت تجعل المسار الأول
   ينجح غالباً وتغنيك عن الوسطاء.
   ===================================================================== */
const ROUTES = [
  u => u,
  u => 'https://api.allorigins.win/raw?url=' + encodeURIComponent(u),
  u => 'https://corsproxy.io/?url=' + encodeURIComponent(u)
];
let goodRoute = 0;                 // نتذكّر المسار الناجح لتسريع الطلبات التالية

async function getJSON(url){
  const order = [goodRoute, ...ROUTES.keys()].filter((v,i,a)=>a.indexOf(v)===i);
  let last = null;
  for (const i of order){
    try{
      const res = await fetch(ROUTES[i](url), {cache:'no-store'});
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const data = await res.json();
      goodRoute = i;
      return data;
    }catch(e){ last = e; }
  }
  throw new Error('تعذّر الوصول إلى بيانات الدوري (' + (last?.message || 'اتصال محجوب') + ')');
}

async function fetchFixtures(){
  const raw = await getJSON(`${CFG.API}/fixtures/`);
  if (!Array.isArray(raw)) throw new Error('البيانات المستلمة غير متوقّعة');

  S.fixtures = raw.map(f => ({
    id: f.id,
    round: f.event,
    kickoff: f.kickoff_time,
    provisional: !!f.provisional_start_time,
    home: f.team_h, away: f.team_a,
    hs: f.team_h_score, as: f.team_a_score,
    started: !!f.started,
    finished: !!f.finished && f.team_h_score !== null
  })).sort((a,b)=> new Date(a.kickoff) - new Date(b.kickoff));

  S.byRound = {}; 
  S.fixtures.forEach(f => (S.byRound[f.round] ||= []).push(f));
  S.rounds = Object.keys(S.byRound).map(Number).sort((a,b)=>a-b);

  const open = S.rounds.find(r => S.byRound[r].some(f => !f.finished));
  S.currentRound = open || S.rounds[S.rounds.length-1];
}

async function fetchPreds(){
  if (!sb || !sbConnected) { 
    console.warn('⚠️ Supabase غير متصل، جلب التوقعات محلياً');
    S.preds = []; 
    return; 
  }
  try {
    const { data, error } = await sb.from('predictions')
      .select('*').eq('competition', CFG.COMP).limit(10000);
    if (error) { 
      console.warn('❌ تعذّر جلب التوقعات', error); 
      S.preds = []; 
      return; 
    }
    S.preds = data || [];
    console.log(`✅ تم جلب ${S.preds.length} توقع`);
  } catch(e) {
    console.warn('⚠️ استثناء عند جلب التوقعات', e);
    S.preds = [];
  }
}


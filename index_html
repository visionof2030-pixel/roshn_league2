function renderRounds(){
  $('#rounds').innerHTML = S.rounds.map(r=>{
    const done = S.byRound[r]?.every(f=>f.finished) || false;
    const shut = r > S.currentRound;
    return `<button class="round-b ${r===S.viewRound?'on':''} ${done||shut?'done':''}" data-r="${r}">
      ج${r}${r===S.currentRound?' •':(shut?' 🔒':'')}</button>`;
  }).join('');
  $$('#rounds .round-b').forEach(b=>b.onclick=()=>{
    S.viewRound = +b.dataset.r; renderRounds(); renderMatches();
  });
  const on = $('#rounds .round-b.on'); if (on) on.scrollIntoView({block:'nearest',inline:'center'});
}

function myPred(fid){
  return S.preds.find(p => p.user_name === S.me && p.match_id === 'spl_' + fid) || null;
}
function predsOf(fid){
  return S.preds.filter(p => p.match_id === 'spl_' + fid);
}
function outcome(f){
  if (!f.finished) return null;
  if (f.hs > f.as) return 'HOME';
  if (f.as > f.hs) return 'AWAY';
  return 'DRAW';
}
function predLabel(f, v){
  if (v === 'DRAW') return 'تعادل';
  return 'فوز ' + tName(v === 'HOME' ? f.home : f.away);
}

function renderMatches(){
  const list = S.byRound[S.viewRound] || [];
  if (!list.length){ $('#matches').innerHTML = `<div class="empty"><span>📭</span> لا توجد مباريات في هذه الجولة</div>`; return; }

  $('#matches').innerHTML = list.map(f=>{
    const live = f.started && !f.finished;
    const res  = outcome(f);
    const mine = myPred(f.id);
    const all  = predsOf(f.id);

    let mid;
    if (f.finished)      mid = `<div class="score g">${f.hs} - ${f.as}</div>`;
    else if (live)       mid = `<div class="score">${f.hs ?? 0} - ${f.as ?? 0}</div>`;
    else                 mid = `<div class="ko">${ksaTime(f.kickoff)}</div>
                                <div class="ko-d">${countdown(f.kickoff)}</div>`;

    // شريط توزيع التوقعات
    let bars = '';
    if (all.length){
      const h = all.filter(p=>p.prediction==='HOME').length;
      const d = all.filter(p=>p.prediction==='DRAW').length;
      const a = all.filter(p=>p.prediction==='AWAY').length;
      const pc = n => (n/all.length*100).toFixed(0);
      bars = `<div class="bars">
          <i style="width:${pc(h)}%;background:${tColor(f.home)}"></i>
          <i style="width:${pc(d)}%;background:#4a5c52"></i>
          <i style="width:${pc(a)}%;background:${tColor(f.away)}"></i>
        </div>
        <div class="bars-l"><span>${pc(h)}%</span><span>تعادل ${pc(d)}%</span><span>${pc(a)}%</span></div>`;
    }

    // حالة توقعي
    let mineHtml = '';
    if (mine){
      const cls = !res ? '' : (mine.prediction === res ? 'ok' : 'no');
      const mark = !res ? '' : (mine.prediction === res ? ' ✅' : ' ❌');
      mineHtml = `<div class="p-mine ${cls}">توقعك: ${predLabel(f, mine.prediction)}${mark}</div>`;
    }

    // الأزرار — التوقع مسموح في الجولة المفتوحة فقط
    let actions;
    if (f.round > S.currentRound){
      actions = `<button class="btn" disabled>🔒 تُفتح بعد الجولة ${S.currentRound}</button>`;
    } else if (f.finished || isLocked(f.kickoff)){
      actions = `<button class="btn" onclick="openMatch(${f.id})">📋 التوقعات (${all.length})</button>`;
    } else {
      actions = `<button class="btn solid" onclick="openPick(${f.id})">${mine ? '✏️ تعديل توقعي' : '🔮 توقّع'}</button>
                 <button class="btn" onclick="openMatch(${f.id})">📋 ${all.length}</button>`;
    }

    return `<article class="match ${live?'live':''} ${f.finished?'done':''}">
      <div class="m-head">
        <span>${f.provisional ? 'موعد مبدئي' : ksaDate(f.kickoff)}</span>
        <span class="${live?'m-live':''}">${live?'● تُلعب الآن':(f.finished?'انتهت':'الجولة '+f.round)}</span>
      </div>
      <div class="m-row">
        <div class="side">${crest(f.home)}<span class="side-name">${tName(f.home)}</span></div>
        <div class="m-mid">${mid}</div>
        <div class="side">${crest(f.away)}<span class="side-name">${tName(f.away)}</span></div>
      </div>
      ${bars}
      ${mineHtml}
      <div class="m-foot">${actions}</div>
    </article>`;
  }).join('');
}

/* =====================================================================
   5) الترتيب
   ===================================================================== */
function renderTable(){
  const t = {};
  Object.keys(TEAMS).forEach(id => t[id] = {id:+id,p:0,w:0,d:0,l:0,gf:0,ga:0,pts:0});

  let played = 0;
  S.fixtures.filter(f=>f.finished).forEach(f=>{
    played++;
    const H = t[f.home], A = t[f.away];
    if (!H || !A) return;
    H.p++; A.p++; H.gf+=f.hs; H.ga+=f.as; A.gf+=f.as; A.ga+=f.hs;
    if (f.hs > f.as){ H.w++; H.pts+=3; A.l++; }
    else if (f.as > f.hs){ A.w++; A.pts+=3; H.l++; }
    else { H.d++; A.d++; H.pts++; A.pts++; }
  });

  const rows = Object.values(t).sort((a,b)=>
    b.pts-a.pts || (b.gf-b.ga)-(a.gf-a.ga) || b.gf-a.gf || tName(a.id).localeCompare(tName(b.id))
  );

  $('#tblNote').textContent = played ? `${played} مباراة` : 'لم تبدأ المنافسة بعد';

  $('#tbl').innerHTML = `
    <thead><tr>
      <th>#</th><th style="text-align:right">النادي</th>
      <th>ل</th><th>ف</th><th>ت</th><th>خ</th><th>له</th><th>عليه</th><th>±</th><th>ن</th>
    </tr></thead>
    <tbody>${rows.map((r,i)=>{
      const cls = i<4 ? 'acl' : (i>=15 ? 'rel' : '');
      const gd = r.gf - r.ga;
      return `<tr class="${cls}">
        <td class="pos">${i+1}</td>
        <td class="team">${crest(r.id)}<span>${tName(r.id)}</span></td>
        <td>${r.p}</td><td>${r.w}</td><td>${r.d}</td><td>${r.l}</td>
        <td>${r.gf}</td><td>${r.ga}</td><td>${gd>0?'+':''}${gd}</td>
        <td class="pts">${r.pts}</td>
      </tr>`;
    }).join('')}</tbody>`;
}

/* =====================================================================
   6) المتصدرون
   ===================================================================== */
function fixtureById(id){ return S.fixtures.find(f=>f.id===id); }

function scoreboard(){
  const map = {};
  S.preds.forEach(p=>{
    const fid = +String(p.match_id).replace('spl_','');
    const f = fixtureById(fid); if (!f) return;
    const u = (map[p.user_name] ||= {name:p.user_name, pts:0, ok:0, no:0, total:0, wait:0});
    u.total++;
    const res = outcome(f);
    if (!res) { u.wait++; return; }
    if (p.prediction === res){ u.pts++; u.ok++; } else u.no++;
  });
  return Object.values(map).sort((a,b)=>{
    if (b.pts !== a.pts) return b.pts - a.pts;
    const accA = a.ok+a.no ? a.ok/(a.ok+a.no) : 0;
    const accB = b.ok+b.no ? b.ok/(b.ok+b.no) : 0;
    if (accB !== accA) return accB - accA;
    return b.total - a.total;
  });
}

function renderBoard(){
  const b = scoreboard();
  $('#boardNote').textContent = b.length ? `${b.length} متوقع · ${S.preds.length} توقع` : '—';

  if (!b.length){
    $('#board').innerHTML = `<div class="empty"><span>📭</span> لا توجد توقعات بعد<br><small>كن أول من يتوقّع في الجولة ${S.currentRound}</small></div>`;
    return;
  }
  const acc = u => (u.ok+u.no) ? Math.round(u.ok/(u.ok+u.no)*100) : 0;
  const top = b[0];

  let html = `<div class="champ" onclick="openPlayer('${top.name.replace(/'/g,"\\'")}')">
    <div class="av">${top.name.charAt(0)}</div>
    <div class="who">
      <h3>${top.name}</h3>
      <div class="line">
        <span>🏆 <b>${top.pts}</b> نقطة</span>
        <span>✅ <b>${top.ok}</b></span>
        <span>🎯 <b>${acc(top)}%</b></span>
        <span>📊 <b>${top.total}</b> توقع</span>
      </div>
    </div>
  </div><div class="people">`;

  html += b.slice(1).map((u,i)=>`
    <div class="person ${u.name===S.me?'me':''}" onclick="openPlayer('${u.name.replace(/'/g,"\\'")}')">
      <span class="rk">${i+2}</span>
      <span class="av">${u.name.charAt(0)}</span>
      <span class="nm">
        <span class="n1">${u.name}${u.name===S.me?' ·أنت':''}</span>
        <span class="n2"><span>✅ ${u.ok}</span><span>🎯 ${acc(u)}%</span><span>📊 ${u.total}</span></span>
      </span>
      <span class="sc">${u.pts}</span>
    </div>`).join('');

  $('#board').innerHTML = html + '</div>';
}

